{
  "schemaVersion": 1,
  "workflows": {
    "ci": {
      "name": "CI",
      "path": ".github/workflows/ci.yml",
      "event": "push",
      "headBranch": "main",
      "requiredJobs": [
        "build-and-coverage",
        "chrome / Node 22 / shard 1/1",
        "chromium / Node 22 / shard 1/1",
        "companion coverage / lyra-3d",
        "companion coverage / lyra-flags",
        "companion coverage / lyra-ide",
        "companion coverage / lyra-map",
        "companion coverage / lyra-translations",
        "docs-and-storybook",
        "edge / Node 22 / shard 1/1",
        "firefox / Node 22 / shard 1/2",
        "firefox / Node 22 / shard 2/2",
        "lint",
        "packed-consumer",
        "safari / Node 22 / shard 1/1",
        "scale-budgets",
        "static-checks",
        "visual-regression"
      ]
    },
    "fullEngine": {
      "name": "Full browser-engine suite",
      "path": ".github/workflows/full-engine.yml",
      "event": "workflow_dispatch",
      "headBranch": "main",
      "requiredJobs": [
        "firefox / shard 1/10",
        "firefox / shard 10/10",
        "firefox / shard 2/10",
        "firefox / shard 3/10",
        "firefox / shard 4/10",
        "firefox / shard 5/10",
        "firefox / shard 6/10",
        "firefox / shard 7/10",
        "firefox / shard 8/10",
        "firefox / shard 9/10",
        "webkit / shard 1/6",
        "webkit / shard 2/6",
        "webkit / shard 3/6",
        "webkit / shard 4/6",
        "webkit / shard 5/6",
        "webkit / shard 6/6"
      ]
    },
    "qualityTools": {
      "name": "Quality tools",
      "path": ".github/workflows/quality-tools.yml",
      "event": "workflow_dispatch",
      "headBranch": "main",
      "requiredJobs": [
        "A/B benchmark (tachometer)",
        "bundle composition",
        "flake hunt (Chromium)",
        "mutation testing (lyra-map)"
      ]
    },
    "testAllBrowsers": {
      "name": "Test All Browsers",
      "path": ".github/workflows/test-all-browsers.yml",
      "event": "workflow_dispatch",
      "headBranch": "main",
      "requiredJobs": [
        "chrome",
        "chromium",
        "edge"
      ]
    }
  }
}
