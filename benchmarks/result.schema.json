{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "passed",
            "failed",
            "unsupported"
          ]
        },
        "code": {
          "enum": [
            null,
            "browser-unavailable",
            "browser-crashed",
            "scenario-timeout",
            "fixture-not-ready",
            "fixture-contract",
            "sample-schema",
            "assertion-failed",
            "page-error",
            "network-blocked",
            "not-run",
            "setup-failed",
            "cleanup-failed",
            "cancelled",
            "build-failed",
            "package-invalid",
            "node-version",
            "internal-error",
            "UNKNOWN_SCENARIO",
            "INVALID_SAMPLE",
            "BUSY",
            "SETUP_FAILED",
            "OPERATION_FAILED",
            "TIMEOUT",
            "SEMANTIC_CHECK_FAILED",
            "PEER_UNAVAILABLE",
            "PAGE_NOT_VISIBLE"
          ]
        },
        "metrics": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "assignmentMs": {
              "type": "number",
              "minimum": 0
            },
            "updateMs": {
              "type": "number",
              "minimum": 0
            },
            "settleMs": {
              "type": "number",
              "minimum": 0
            },
            "paintMs": {
              "type": "number",
              "minimum": 0
            },
            "totalMs": {
              "type": "number",
              "minimum": 0
            },
            "noopAssignmentMs": {
              "type": "number",
              "minimum": 0
            },
            "noopUpdateMs": {
              "type": "number",
              "minimum": 0
            },
            "noopSettleMs": {
              "type": "number",
              "minimum": 0
            },
            "noopPaintMs": {
              "type": "number",
              "minimum": 0
            },
            "noopTotalMs": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": []
        },
        "assertions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "enum": [
                  "control-connected",
                  "table-retained-count",
                  "table-truncation-state",
                  "table-page-bound",
                  "table-rendered-values",
                  "table-total-items",
                  "table-controlled-page",
                  "table-view-values",
                  "chart-peer-ready",
                  "chart-retained-count",
                  "chart-plot-bound",
                  "chart-table-bound",
                  "chart-sample-endpoints",
                  "chart-plot-values",
                  "chart-table-values",
                  "chart-accessible-label",
                  "option-catalog-count",
                  "option-labels-current",
                  "option-selected-label",
                  "option-stays-closed"
                ]
              },
              "passed": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "passed"
            ]
          }
        },
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sourceCount": {
              "type": "integer",
              "minimum": 0
            },
            "retainedCount": {
              "type": "integer",
              "minimum": 0
            },
            "renderedRowCount": {
              "type": "integer",
              "minimum": 0
            },
            "plottedRecordCount": {
              "type": "integer",
              "minimum": 0
            },
            "tableCellCount": {
              "type": "integer",
              "minimum": 0
            },
            "formatterTableCalls": {
              "type": "integer",
              "minimum": 0
            },
            "noopFormatterTableCalls": {
              "type": "integer",
              "minimum": 0
            },
            "checkedLabels": {
              "type": "integer",
              "minimum": 0
            },
            "shadowElementCount": {
              "type": "integer",
              "minimum": 0
            },
            "page": {
              "type": "integer",
              "minimum": 0
            },
            "totalItems": {
              "type": "integer",
              "minimum": 0
            },
            "viewRowCount": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": []
        }
      },
      "required": [
        "status",
        "code",
        "metrics",
        "assertions",
        "counts"
      ]
    }
  },
  "title": "Lyra UI synthetic benchmark result",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "recordedAt": {
      "type": "string",
      "format": "date-time"
    },
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "fixturesHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "hash",
        "fixturesHash"
      ]
    },
    "library": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][a-zA-Z0-9.-]+)?$"
        },
        "distHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "publicCommit": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            }
          ]
        }
      },
      "required": [
        "version",
        "distHash",
        "publicCommit"
      ]
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "node": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][a-zA-Z0-9.-]+)?$"
        },
        "playwright": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][a-zA-Z0-9.-]+)?$"
        },
        "vite": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][a-zA-Z0-9.-]+)?$"
        },
        "chartJs": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][a-zA-Z0-9.-]+)?$"
        },
        "os": {
          "enum": [
            "linux",
            "darwin",
            "win32",
            "freebsd",
            "openbsd",
            "aix",
            "sunos"
          ]
        },
        "osVersion": {
          "type": "string",
          "pattern": "^\\d+(?:\\.\\d+){0,2}$"
        },
        "arch": {
          "enum": [
            "x64",
            "arm64",
            "arm",
            "ia32",
            "ppc64",
            "s390x",
            "riscv64",
            "loong64"
          ]
        },
        "cpuModel": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9 ()@.+-]{1,120}$"
        },
        "logicalCpus": {
          "type": "integer",
          "minimum": 1
        },
        "memoryBytes": {
          "type": "integer",
          "minimum": 1
        },
        "dpr": {
          "type": "number",
          "minimum": 0.1
        },
        "viewport": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "width",
            "height"
          ]
        },
        "headless": {
          "type": "boolean"
        },
        "softwareRendering": {
          "type": "boolean"
        }
      },
      "required": [
        "node",
        "playwright",
        "vite",
        "chartJs",
        "os",
        "osVersion",
        "arch",
        "cpuModel",
        "logicalCpus",
        "memoryBytes",
        "dpr",
        "viewport",
        "headless",
        "softwareRendering"
      ]
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profile": {
          "enum": [
            "quick",
            "stress"
          ]
        },
        "samples": {
          "type": "integer",
          "minimum": 3,
          "maximum": 50
        },
        "warmups": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 120000
        },
        "browsers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "chromium",
              "firefox",
              "webkit",
              "chrome",
              "edge"
            ]
          }
        },
        "scenarioIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "noop-control",
              "table-assign-1000",
              "table-assign-10000",
              "table-sort-10000",
              "table-filter-10000",
              "table-million-boundary",
              "table-million-page",
              "chart-assign-1000",
              "chart-assign-10000",
              "chart-label-only-1000",
              "option-select-metadata-100",
              "option-select-metadata-1000",
              "option-select-metadata-5000",
              "option-combobox-metadata-100",
              "option-combobox-metadata-1000",
              "option-combobox-metadata-5000"
            ]
          }
        }
      },
      "required": [
        "profile",
        "samples",
        "warmups",
        "timeoutMs",
        "browsers",
        "scenarioIds"
      ]
    },
    "browsers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "enum": [
              "chromium",
              "firefox",
              "webkit",
              "chrome",
              "edge"
            ]
          },
          "version": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "pattern": "^\\d+(?:\\.\\d+){0,4}$"
              }
            ]
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "unavailable",
              "incomplete"
            ]
          },
          "code": {
            "enum": [
              null,
              "browser-unavailable",
              "browser-crashed",
              "scenario-timeout",
              "fixture-not-ready",
              "fixture-contract",
              "sample-schema",
              "assertion-failed",
              "page-error",
              "network-blocked",
              "not-run",
              "setup-failed",
              "cleanup-failed",
              "cancelled",
              "build-failed",
              "package-invalid",
              "node-version",
              "internal-error"
            ]
          },
          "scenarios": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "enum": [
                    "noop-control",
                    "table-assign-1000",
                    "table-assign-10000",
                    "table-sort-10000",
                    "table-filter-10000",
                    "table-million-boundary",
                    "table-million-page",
                    "chart-assign-1000",
                    "chart-assign-10000",
                    "chart-label-only-1000",
                    "option-select-metadata-100",
                    "option-select-metadata-1000",
                    "option-select-metadata-5000",
                    "option-combobox-metadata-100",
                    "option-combobox-metadata-1000",
                    "option-combobox-metadata-5000"
                  ]
                },
                "parameters": {
                  "type": "object"
                },
                "status": {
                  "enum": [
                    "passed",
                    "failed",
                    "unsupported",
                    "not-run"
                  ]
                },
                "code": {
                  "enum": [
                    null,
                    "browser-unavailable",
                    "browser-crashed",
                    "scenario-timeout",
                    "fixture-not-ready",
                    "fixture-contract",
                    "sample-schema",
                    "assertion-failed",
                    "page-error",
                    "network-blocked",
                    "not-run",
                    "setup-failed",
                    "cleanup-failed",
                    "cancelled",
                    "build-failed",
                    "package-invalid",
                    "node-version",
                    "internal-error",
                    "UNKNOWN_SCENARIO",
                    "INVALID_SAMPLE",
                    "BUSY",
                    "SETUP_FAILED",
                    "OPERATION_FAILED",
                    "TIMEOUT",
                    "SEMANTIC_CHECK_FAILED",
                    "PEER_UNAVAILABLE",
                    "PAGE_NOT_VISIBLE"
                  ]
                },
                "samples": {
                  "type": "array",
                  "maxItems": 50,
                  "items": {
                    "$ref": "#/$defs/sample"
                  }
                },
                "warmupStatus": {
                  "enum": [
                    "passed",
                    "failed",
                    "unsupported",
                    "not-run"
                  ]
                }
              },
              "required": [
                "id",
                "parameters",
                "status",
                "code",
                "samples",
                "warmupStatus"
              ],
              "oneOf": [
                {
                  "properties": {
                    "id": {
                      "const": "noop-control"
                    },
                    "parameters": {
                      "const": {
                        "inputCount": 0
                      }
                    }
                  }
                },
                {
                  "properties": {
                    "id": {
                      "const": "table-assign-1000"
                    },
                    "parameters": {
                      "const": {
                        "inputCount": 1000,
                        "pageSize": 100
                      }
                    }
                  }
                },
                {
                  "properties": {
                    "id": {
                      "const": "table-assign-10000"
                    },
                    "parameters": {
                      "const": {
                        "inputCount": 10000,
                        "pageSize": 100
                      }
                    }
                  }
                },
                {
                  "properties": {
                    "id": {
                      "const": "table-sort-10000"
                    },
                    "parameters": {
                      "const": {
                        "inputCount": 10000,
                        "pageSize": 100,
                        "numericSort": true
                      }
                    }
                  }
                },
                {
                  "properties": {
                    "id": {
                      "const": "table-filter-10000"
                    },
                    "parameters": {
                      "const": {
                        "inputCount": 10000,
                        "pageSize": 100,
                        "matchingCount": 1000,
                        "textFilter": true
                      }
                    }
                  }
                },
                {
                  "properties": {
                    "id": {
                      "const": "table-million-boundary"
                    },
                    "parameters": {
                      "const": {
                        "inputCount": 1000000,
                        "pageSize": 100
                      }
                    }
                  }
                },
                {
                  "properties": {
                    "id": {
                      "const": "table-million-page"
                    },
                    "parameters": {
                      "const": {
                        "inputCount": 1000000,
                        "pageSize": 100,
                        "serverPagination": true
                      }
                    }
                  }
                },
                {
                  "properties": {
                    "id": {
                      "const": "chart-assign-1000"
                    },
                    "parameters": {
                      "const": {
                        "inputCount": 1000,
                        "plotBudget": 1000
                      }
                    }
                  }
                },
                {
                  "properties": {
                    "id": {
                      "const": "chart-assign-10000"
                    },
                    "parameters": {
                      "const": {
                        "inputCount": 10000,
                        "plotBudget": 1000
                      }
                    }
                  }
                },
                {
                  "properties": {
                    "id": {
                      "const": "chart-label-only-1000"
                    },
                    "parameters": {
                      "const": {
                        "inputCount": 1000,
                        "plotBudget": 1000,
                        "labelOnly": true
                      }
                    }
                  }
                },
                {
                  "properties": {
                    "id": {
                      "const": "option-select-metadata-100"
                    },
                    "parameters": {
                      "const": {
                        "inputCount": 100,
                        "closed": true
                      }
                    }
                  }
                },
                {
                  "properties": {
                    "id": {
                      "const": "option-select-metadata-1000"
                    },
                    "parameters": {
                      "const": {
                        "inputCount": 1000,
                        "closed": true
                      }
                    }
                  }
                },
                {
                  "properties": {
                    "id": {
                      "const": "option-select-metadata-5000"
                    },
                    "parameters": {
                      "const": {
                        "inputCount": 5000,
                        "closed": true
                      }
                    }
                  }
                },
                {
                  "properties": {
                    "id": {
                      "const": "option-combobox-metadata-100"
                    },
                    "parameters": {
                      "const": {
                        "inputCount": 100,
                        "closed": true
                      }
                    }
                  }
                },
                {
                  "properties": {
                    "id": {
                      "const": "option-combobox-metadata-1000"
                    },
                    "parameters": {
                      "const": {
                        "inputCount": 1000,
                        "closed": true
                      }
                    }
                  }
                },
                {
                  "properties": {
                    "id": {
                      "const": "option-combobox-metadata-5000"
                    },
                    "parameters": {
                      "const": {
                        "inputCount": 5000,
                        "closed": true
                      }
                    }
                  }
                }
              ]
            }
          }
        },
        "required": [
          "id",
          "version",
          "status",
          "code",
          "scenarios"
        ]
      }
    },
    "status": {
      "enum": [
        "passed",
        "failed",
        "incomplete"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "recordedAt",
    "harness",
    "library",
    "environment",
    "configuration",
    "browsers",
    "status"
  ]
}
