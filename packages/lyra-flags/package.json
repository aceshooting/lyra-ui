{
  "name": "@aceshooting/lyra-flags",
  "version": "2.3.0",
  "description": "Waving country/territory flag SVGs — optional companion asset package for <lr-flag> in lyra-ui.",
  "keywords": [
    "flag-icons",
    "flags",
    "country-flags",
    "svg",
    "i18n",
    "web-components"
  ],
  "license": "SEE LICENSE IN README.md",
  "type": "module",
  "author": {
    "name": "Aceshooting",
    "email": "info@aceshooting.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aceshooting/lyra-ui.git",
    "directory": "packages/lyra-flags"
  },
  "homepage": "https://www.lyra-ui.com/",
  "bugs": {
    "url": "https://github.com/aceshooting/lyra-ui/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "scripts": {
    "generate": "node scripts/generate-index.mjs",
    "optimize": "node scripts/optimize-flags.mjs",
    "build-compact": "node scripts/build-compact.mjs",
    "check:public-api": "node ../lyra-ui/scripts/public-api-diff.mjs --current .",
    "test": "node scripts/test.mjs",
    "prepack": "pnpm run generate"
  },
  "files": [
    "flags",
    "index.js",
    "index.d.ts",
    "standard.js",
    "standard.d.ts",
    "compact.js",
    "compact.d.ts",
    "detailed.js",
    "detailed.d.ts",
    "THIRD_PARTY_NOTICES.md",
    "CHANGELOG.md"
  ],
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./standard": {
      "types": "./standard.d.ts",
      "default": "./standard.js"
    },
    "./compact": {
      "types": "./compact.d.ts",
      "default": "./compact.js"
    },
    "./detailed": {
      "types": "./detailed.d.ts",
      "default": "./detailed.js"
    },
    "./flags/*": "./flags/*"
  },
  "packageManager": "pnpm@11.25.0",
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "sharp": "^0.35.4",
    "svgo": "^4.1.0"
  }
}
