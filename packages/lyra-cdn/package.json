{
  "name": "@aceshooting/lyra-cdn",
  "version": "33.3.0",
  "description": "Single-script-tag build of @aceshooting/lyra-ui with every optional peer, the locale catalogs and the lyra-gen, lyra-docs, lyra-map, lyra-3d and lyra-flags companions bundled into lazy chunks: no build step and no import map.",
  "keywords": [
    "lyra-ui",
    "cdn",
    "jsdelivr",
    "unpkg",
    "web-components",
    "lit",
    "lyra-gen",
    "lyra-docs",
    "lyra-map"
  ],
  "license": "MIT",
  "type": "module",
  "author": {
    "name": "Aceshooting",
    "email": "info@aceshooting.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aceshooting/lyra-ui.git",
    "directory": "packages/lyra-cdn"
  },
  "homepage": "https://www.lyra-ui.com/",
  "bugs": {
    "url": "https://github.com/aceshooting/lyra-ui/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.23.0",
  "sideEffects": true,
  "jsdelivr": "./dist/lyra-ui.loader.js",
  "unpkg": "./dist/lyra-ui.loader.js",
  "exports": {
    "./lyra-ui.loader.js": "./dist/lyra-ui.loader.js",
    "./lyra-gen.js": "./dist/lyra-gen.js",
    "./lyra-docs.js": "./dist/lyra-docs.js",
    "./phone-numbers.js": "./dist/phone-numbers.js",
    "./theme.css": "./dist/theme.css",
    "./theme-core.css": "./dist/theme-core.css",
    "./density.css": "./dist/density.css",
    "./accents.css": "./dist/accents.css",
    "./accent-roles.css": "./dist/accent-roles.css",
    "./design-tokens.css": "./dist/design-tokens.css",
    "./native.css": "./dist/native.css",
    "./utilities.css": "./dist/utilities.css",
    "./docx-editor.css": "./dist/docx-editor.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "pnpm --filter @aceshooting/lyra-ui build && pnpm --filter @aceshooting/lyra-map --filter @aceshooting/lyra-3d --filter @aceshooting/lyra-gen --filter @aceshooting/lyra-docs build && node scripts/build.mjs",
    "test": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@aceshooting/lyra-3d": "workspace:*",
    "@aceshooting/lyra-docs": "workspace:*",
    "@aceshooting/lyra-flags": "workspace:*",
    "@aceshooting/lyra-gen": "workspace:*",
    "@aceshooting/lyra-map": "workspace:*",
    "@aceshooting/lyra-ui": "workspace:*",
    "playwright": "^1.65.1"
  }
}
