  "bin": {
    "lyra-gen": "./bin/lyra-gen.mjs"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "lint": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json && pnpm check:types && pnpm check:browser-types",
    "test": "pnpm build && node scripts/run-tests.mjs",
    "test:browser": "web-test-runner --config web-test-runner.config.mjs",
    "test:visual": "node ../../benchmarks/generative-ui/visual.mjs --browser=chromium --baselines=../../benchmarks/generative-ui/visual-baselines/chromium",
    "prepack": "pnpm --filter @aceshooting/lyra-ui build && pnpm build",
    "check:catalog": "node scripts/check-catalog.mjs",
    "check:types": "tsc -p tsconfig.types.json",
    "check:browser-types": "tsc -p tsconfig.browser-test.json",
    "check:build-artifacts": "node --test scripts/check-build-artifacts.test.mjs && node scripts/check-build-artifacts.mjs",
    "check:examples": "tsc -p tsconfig.examples.json",
    "test:saved-dashboard": "node --test test/host/saved-dashboard.test.mjs",
    "check:bundles": "node scripts/measure-bundles.mjs",
    "check:api": "node --test scripts/check-api.test.mjs && node scripts/check-api.mjs"
  },
  "dependencies": {
    "lit": "^3.3.3",
    "tslib": "^2.8.1"
  },
  "peerDependencies": {
    "@aceshooting/lyra-ui": "workspace:^"
  },
  "devDependencies": {
    "@a2a-js/sdk": "1.3.0",
    "@aceshooting/lyra-translations": "workspace:*",
    "@aceshooting/lyra-ui": "workspace:*",
    "@ag-ui/client": "1.0.3",
    "@ag-ui/core": "1.0.3",
    "@lit-labs/ssr": "^4.1.0",
    "@open-wc/testing": "^5.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "@web/dev-server-esbuild": "^2.0.0",
    "@web/test-runner": "^1.0.0",
    "@web/test-runner-commands": "^1.0.1",
    "ai": "7.0.154",
    "ajv": "8.20.0",
    "esbuild": "^0.28.2",
    "fast-check": "^4.10.2",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@12.15.0"
}
