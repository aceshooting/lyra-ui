      "default": "./dist/authoring.js"
    },
    "./templates.js": {
      "types": "./dist/templates.d.ts",
      "default": "./dist/templates.js"
    },
    "./runtime.js": {
      "types": "./dist/runtime.d.ts",
      "default": "./dist/runtime.js"
    },
    "./references.js": {
      "types": "./dist/references.d.ts",
