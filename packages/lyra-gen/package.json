{
  "name": "@aceshooting/lyra-gen",
  "version": "1.1.0",
  "description": "Catalog-bound generated views, interactive answers and portable dashboard contracts for Lyra UI.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aceshooting/lyra-ui.git",
    "directory": "packages/lyra-gen"
  },
  "files": [
    "dist",
    "bin",
    "docs",
    "examples",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "./dist/gen-view.js",
    "./dist/dashboard-binding.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
