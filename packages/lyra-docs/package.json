{
  "name": "@aceshooting/lyra-docs",
  "version": "0.4.1",
  "description": "Experimental native Lyra DOCX editor with lazy document engine loading",
  "keywords": [
    "docx",
    "document-editor",
    "web-components",
    "lit"
  ],
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Aceshooting",
    "email": "info@aceshooting.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aceshooting/lyra-ui.git",
    "directory": "packages/lyra-docs"
  },
  "homepage": "https://github.com/aceshooting/lyra-ui/tree/main/packages/lyra-docs#readme",
  "bugs": {
    "url": "https://github.com/aceshooting/lyra-ui/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.10.1",
  "sideEffects": [
    "./dist/docx/editor.js",
    "./src/docx/editor.ts",
    "./dist/docx/editor.css"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./docx": {
      "types": "./dist/docx/index.d.ts",
      "default": "./dist/docx/index.js"
    },
    "./package.json": "./package.json",
    "./docx/editor": {
      "types": "./dist/docx/editor.d.ts",
      "default": "./dist/docx/editor.js"
    },
    "./docx/editor.class": {
      "types": "./dist/docx/docx-editor.class.d.ts",
      "default": "./dist/docx/docx-editor.class.js"
    },
    "./docx/editor.css": "./dist/docx/editor.css"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "THIRD_PARTY_LICENSES"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "pnpm --filter @aceshooting/lyra-ui build && pnpm build",
    "lint": "tsc --noEmit -p tsconfig.test.json && node scripts/check-package.mjs",
    "test": "pnpm build && tsc --noEmit -p tsconfig.exports.json && tsc -p tsconfig.test.json && node --test --test-concurrency=2 .test-output/src/docx/*.test.js scripts/package.test.mjs test/xml.test.mjs",
    "test:browser": "node scripts/browser-test.mjs",
    "test:coverage": "node scripts/coverage.mjs"
  },
  "devDependencies": {
    "@aceshooting/lyra-ui": "workspace:*",
    "@types/node": "26.6.5",
    "typescript": "^7.0.2",
    "@docx-editor.dev/core": "2.27.0",
    "axe-core": "^4.14.0",
    "playwright": "^1.64.0",
    "vite": "^8.3.4",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-report": "^3.0.1",
    "istanbul-reports": "^3.2.0",
    "v8-to-istanbul": "^9.3.0"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "lit": "^3.3.3",
    "saxes": "^6.0.0"
  },
  "peerDependencies": {
    "@aceshooting/lyra-ui": "workspace:^",
    "@docx-editor.dev/core": "2.27.0"
  },
  "peerDependenciesMeta": {
    "@docx-editor.dev/core": {
      "optional": true
    }
  }
}
