{
  "name": "@aceshooting/lyra-docs",
  "version": "0.1.0",
  "private": true,
  "description": "Experimental type contracts for optional document editors",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=22" },
  "packageManager": "pnpm@12.8.1",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./docx": { "types": "./dist/docx/index.d.ts", "default": "./dist/docx/index.js" },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "LICENSE", "THIRD_PARTY_NOTICES.md"],
  "scripts": {
    "build": "node scripts/build.mjs",
    "lint": "tsc --noEmit -p tsconfig.test.json && node scripts/check-package.mjs",
    "test": "pnpm build && tsc --noEmit -p tsconfig.exports.json && tsc -p tsconfig.test.json && node --test --test-concurrency=2 .test-output/src/docx/session.test.js scripts/package.test.mjs"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "typescript": "^7.0.2"
  }
}
