+
+function updatePosition(
+  anchor: OoxmlElement,
+  position: DrawingPositionInput,
+  nextId: () => string
+): OoxmlElement {
+  const simplePos = schemaAttributeValue(anchor.attributes, 'simplePos') === '1';
+  if (simplePos) {
