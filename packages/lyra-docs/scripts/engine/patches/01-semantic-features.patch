+import type { EditorCommand } from '../contracts/editor.ts';
+import { prepareFeature, prepareFeatures, type EditorFeature } from './prepared-runtime.ts';
+import { documentFeatures } from './document-preparation.ts';
+import { readOoxmlPackage } from '../store/package/ooxml-package.ts';
+import { fragmentFromHtml } from '../editor/clipboard-fragment-codec.ts';
+import { projectExternalHtml } from '../editor/clipboard-html-read.ts';
+
+/** Inspect the same bounded rich-paste representations used by the existing paste router. */
+export async function prepareClipboard(html: string | null): Promise<void> {
+  if (!html) return;
+  await prepareFeature('clipboard-html');
+  const embedded = fragmentFromHtml(html);
+  if (embedded) {
+    const opened = readOoxmlPackage(embedded.bytes);
+    if (opened.ok) await prepareFeatures(documentFeatures(opened.package));
+  }
+  // A valid embedded fragment may be refused at its destination. Its HTML fallback must
+  // also be ready before the existing router chooses a lane, without a partial mutation.
+  const projected = projectExternalHtml(html);
+  if (projected.ok) {
+    const opened = readOoxmlPackage(projected.fragmentBytes);
+    if (opened.ok) await prepareFeatures(documentFeatures(opened.package));
+  }
+}
+
+export function commandFeatures(command: EditorCommand): readonly EditorFeature[] {
+  switch (command.type) {
+    case 'insertTable': case 'insertRow': case 'insertColumn': case 'deleteRow':
+    case 'deleteColumn': case 'deleteTable': case 'mergeCells': case 'splitCell':
+    case 'setCellFill': case 'setTableCellVerticalAlignment': case 'toggleHeaderRow':
+    case 'setTableBorders': case 'commitTableColumnDividerResize':
+    case 'commitTableRightEdgeResize': case 'setTableProperties':
+      return ['tables'];
+    case 'insertContentControl': case 'setContentControlValue': case 'removeContentControl':
+    case 'addRepeatingSectionItem': case 'removeRepeatingSectionItem':
+      return ['controls'];
+    case 'insertImage': case 'replaceImage': case 'deleteImage': case 'setImageWrapType':
+    case 'transformImage': case 'setImagePosition': case 'setImageProperties':
+      return ['drawings'];
+    case 'insertTextBox': case 'setWatermark': return ['drawings', 'tables'];
+    case 'addComment': case 'replyComment': case 'resolveComment': return ['comments'];
+    case 'insertToc': case 'refreshToc': return ['toc'];
+    case 'editHeaderFooter': case 'removeHeaderFooter': case 'linkHeaderFooterToPrevious':
+    case 'unlinkHeaderFooterFromPrevious': case 'setHeaderFooterOptions': return ['tables'];
+    case 'insertNote': case 'deleteNote': case 'convertNote': case 'convertAllNotes':
+    case 'setNoteProperties': return ['notes', 'tables'];
+  }
+  return [];
+}
+
+export async function prepareCommandFeatures(command: EditorCommand): Promise<void> {
+  await prepareFeatures(commandFeatures(command));
+  if (command.type === 'paste') await prepareClipboard(command.html ?? null);
+}
