+          id: nextId(),
+          kind: 'generic',
+          namespaceUri: DRAWINGML_MAIN_NAMESPACE_URI,
+          localName: 'graphicFrameLocks',
+          prefix: 'a',
+          namespaceBindings: [],
+          attributes: [...nextLockAttrs.values()],
+          children: [],
+        } as OoxmlElement);
+    frameChildren = [...frameChildren, frameLocks];
+  }
