+  for (const [field, attrName] of MANAGED_LOCK_FIELDS) {
+    if (materializeManagedLocks) {
+      applyManagedLock(attrName, merged[field]);
+    } else if (locks[field] !== undefined) {
+      applyManagedLock(attrName, locks[field]);
+    }
+  }
