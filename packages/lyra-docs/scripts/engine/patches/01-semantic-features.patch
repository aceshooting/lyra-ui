+      id: nextId(),
+      kind: axis.kind === 'generic' ? 'generic' : 'drawingPositionOffset',
+      namespaceUri: WP_NAMESPACE_URI,
+      localName: 'posOffset',
+      prefix: 'wp',
+      namespaceBindings: [],
+      attributes: [],
+      children: [{ id: nextId(), kind: 'textValue', value: String(Math.round(offsetEmu)) }],
+    } as OoxmlElement);
+  }
