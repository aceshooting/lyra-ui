-function assembleFragment(p: Projection, blocks: readonly string[]): Uint8Array {
-  return writeProjectedHtmlPackage({
-    blocks,
-    rels: p.rels,
-    lists: [...p.lists.values()],
-    notes: p.notes,
-    noteRels: p.noteRels,
