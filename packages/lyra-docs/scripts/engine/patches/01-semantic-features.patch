+    id: nextId(),
+    kind: kindMap[spec.wrapLocalName],
+    namespaceUri: WP_NAMESPACE_URI,
+    localName: spec.wrapLocalName,
+    prefix: 'wp',
+    namespaceBindings: [],
+    attributes: attrs,
+    children,
