+   * read a position from; the records always know where it is.
+   */
+  function scrollToContentY(
+    contentY: number,
+    contentHeight: number,
+    options?: {
+      block?: 'start' | 'center' | 'centerIfNeeded' | 'nearest';
+      offsetPx?: number;
+      behavior?: ScrollBehavior;
+    }
+  ): boolean {
