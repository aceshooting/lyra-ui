+
+function projectBlocksMemoized(html: string, limits: HtmlProjectionLimits): ProjectedBlocks {
+  const limitsKey = `${limits.maxHtmlBytes ?? ''}:${limits.maxNodes ?? ''}:${limits.maxDepth ?? ''}:${limits.maxImageBytes ?? ''}`;
