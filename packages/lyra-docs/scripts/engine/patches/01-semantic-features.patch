+  let framePr = findGraphicFramePr(updated);
+  if (!framePr) {
+    framePr = {
+      id: nextId(),
+      kind: 'drawingGraphicFramePr',
+      namespaceUri: WP_NAMESPACE_URI,
+      localName: 'cNvGraphicFramePr',
+      prefix: 'wp',
+      namespaceBindings: [],
+      attributes: [],
+      children: [],
+    } as OoxmlElement;
