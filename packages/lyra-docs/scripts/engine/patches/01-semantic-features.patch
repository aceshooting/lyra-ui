+  const projected = projectBlocksMemoized(html, limits);
+  if (!projected.ok) return { lands: false, imageCount: 0, truncated: false };
+  return {
+    lands: true,
+    imageCount: projected.projection.imageCount,
+    truncated: projected.projection.truncated,
+  };
