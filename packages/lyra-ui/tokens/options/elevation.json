{
  "$schema": "../option-presets.schema.json",
  "schemaVersion": 1,
  "kind": "elevation",
  "presets": {
    "flat": {
      "--lr-theme-shadow-xs": "none",
      "--lr-theme-shadow-s": "none",
      "--lr-theme-shadow-m": "none",
      "--lr-theme-shadow-l": "none",
      "--lr-theme-shadow-xl": "none"
    },
    "raised": {
      "--lr-theme-shadow-xs": {
        "light": "0 1px 3px rgb(var(--lr-theme-shadow-color) / 0.16)",
        "dark": "0 1px 3px rgb(var(--lr-theme-shadow-color) / 0.4)"
      },
      "--lr-theme-shadow-s": {
        "light": "0 2px 6px rgb(var(--lr-theme-shadow-color) / 0.18)",
        "dark": "0 2px 6px rgb(var(--lr-theme-shadow-color) / 0.46)"
      },
      "--lr-theme-shadow-m": {
        "light": "0 4px 12px rgb(var(--lr-theme-shadow-color) / 0.2)",
        "dark": "0 4px 12px rgb(var(--lr-theme-shadow-color) / 0.52)"
      },
      "--lr-theme-shadow-l": {
        "light": "0 8px 24px rgb(var(--lr-theme-shadow-color) / 0.22)",
        "dark": "0 8px 24px rgb(var(--lr-theme-shadow-color) / 0.58)"
      },
      "--lr-theme-shadow-xl": {
        "light": "0 16px 40px rgb(var(--lr-theme-shadow-color) / 0.24)",
        "dark": "0 16px 40px rgb(var(--lr-theme-shadow-color) / 0.68)"
      }
    },
    "tonal": {
      "--lr-theme-shadow-xs": "none",
      "--lr-theme-shadow-s": "none",
      "--lr-theme-shadow-m": "none",
      "--lr-theme-shadow-l": "none",
      "--lr-theme-shadow-xl": "none",
      "--lr-theme-color-surface-container-lowest": {
        "light": "#ffffff",
        "dark": "#141414"
      },
      "--lr-theme-color-surface-container-low": {
        "light": "#f7f7f7",
        "dark": "#202020"
      },
      "--lr-theme-color-surface-container": {
        "light": "#f0f0f0",
        "dark": "#272727"
      },
      "--lr-theme-color-surface-container-high": {
        "light": "#e9e9e9",
        "dark": "#303030"
      },
      "--lr-theme-color-surface-container-highest": {
        "light": "#e2e2e2",
        "dark": "#393939"
      },
      "--lr-theme-color-text-quiet": {
        "light": "#595959",
        "dark": "#b0b0b0"
      }
    }
  }
}
