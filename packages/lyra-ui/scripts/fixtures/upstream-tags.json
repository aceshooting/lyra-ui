    "runtimeMethodEdgeSemantics": {
      "source": {
        "package": "@awesome.me/webawesome",
        "version": "3.11.0",
        "tarballIntegrity": "sha512-WM8kyP+AdAT3/zwNpc/YzN3Nu5pRD6ksREFZAct/DIn6KMnQs8lPVfiPbJrOpKMk8OaSnQX19iiwFGjoswXVXw=="
      },
      "methods": [
        {
          "tag": "wa-page",
          "method": "visiblePixelsInViewport",
          "cases": [
            {
              "case": "null-argument",
              "arguments": ["null"],
              "outcome": {
                "kind": "sentinel",
                "value": null
              }
            },
            {
              "case": "detached-document-element",
              "arguments": ["detached-document-element"],
              "outcome": {
                "kind": "measurement",
                "basis": "ambient-page-viewport"
              }
            }
          ]
        }
      ]
