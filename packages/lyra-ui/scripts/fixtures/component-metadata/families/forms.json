{
  "family": "forms",
  "assignments": {
    "new-component-experimental": [
      "lr-toggle",
      "lr-toggle-group"
    ],
    "published-stable": [
      "lr-button",
      "lr-checkbox",
      "lr-checkbox-group",
      "lr-code-editor",
      "lr-color-picker",
      "lr-combobox",
      "lr-emoji-picker",
      "lr-icon-button",
      "lr-input",
      "lr-locale-picker",
      "lr-number-input",
      "lr-option",
      "lr-phone-input",
      "lr-radio",
      "lr-radio-group",
      "lr-rubric-form",
      "lr-select",
      "lr-slider",
      "lr-swatch-picker",
      "lr-switch",
      "lr-textarea",
      "lr-time-input",
      "lr-time-range",
      "lr-token-input"
    ],
    "published-experimental": [
      "lr-date-input",
      "lr-date-picker"
    ],
    "mapped-experimental": [],
    "introduced-mapped-experimental": [],
    "compatibility-stable": [
      "lr-native-time-input"
    ],
    "introduced-stable": [
      "lr-otp-input",
      "lr-radio-button"
    ]
  },
  "deprecations": [
    {
      "tag": "lr-combobox",
      "kind": "event",
      "name": "lr-retry",
      "since": "22.0.0",
      "replacement": {
        "kind": "event",
        "name": "lr-retry-request",
        "usage": "addEventListener('lr-retry-request', event => { /* Call preventDefault() to veto the proposed action. */ })"
      },
      "removalNotBefore": "24.0.0",
      "rationale": "Cancelable proposals use request event names. The historical event remains a veto alias during its compatibility window."
    }
  ]
}
