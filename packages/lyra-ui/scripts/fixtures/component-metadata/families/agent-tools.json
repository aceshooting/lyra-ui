{
  "family": "agent-tools",
  "assignments": {
    "new-component-experimental": [
      "lr-agent-question",
      "lr-background-runs",
      "lr-budget-meter",
      "lr-change-review",
      "lr-connector-manager",
      "lr-permission-grant",
      "lr-permission-rules",
      "lr-tool-call-block"
    ],
    "published-stable": [
      "lr-activity-feed",
      "lr-agent-eval-dashboard",
      "lr-agent-run",
      "lr-agent-trace",
      "lr-approval-queue",
      "lr-artifact-panel",
      "lr-browser-frame",
      "lr-commit-card",
      "lr-compare-panel",
      "lr-confirm-bar",
      "lr-context-inspector",
      "lr-eval-dataset",
      "lr-eval-result",
      "lr-eval-run",
      "lr-json-schema-viewer",
      "lr-mcp-app",
      "lr-policy-summary",
      "lr-prompt-studio",
      "lr-result-card",
      "lr-result-field",
      "lr-span-waterfall",
      "lr-stack-trace",
      "lr-subagent-panel",
      "lr-task-list",
      "lr-terminal",
      "lr-test-results",
      "lr-thinking-panel",
      "lr-tool-approval-dialog",
      "lr-tool-call-chip",
      "lr-tool-param-form",
      "lr-tool-result-dialog",
      "lr-tool-result-view",
      "lr-tool-select-dialog",
      "lr-tool-timeline",
      "lr-trace-tree"
    ],
    "published-experimental": [],
    "mapped-experimental": [],
    "introduced-mapped-experimental": [],
    "compatibility-stable": [],
    "introduced-stable": []
  },
  "deprecations": [
    {
      "tag": "lr-agent-eval-dashboard",
      "kind": "event",
      "name": "lr-metric-change",
      "since": "unreleased",
      "replacement": {
        "kind": "event",
        "name": "lr-metric-change-request",
        "usage": "@lr-metric-change-request"
      },
      "removalNotBefore": "28.0.0",
      "rationale": "lr-metric-change-request names what the event is, a request the host decides on; the alias fires right after it for one major."
    },
    {
      "tag": "lr-agent-run",
      "kind": "event",
      "name": "lr-cancel",
      "since": "unreleased",
      "replacement": {
        "kind": "event",
        "name": "lr-run-cancel",
        "usage": "@lr-run-cancel"
      },
      "removalNotBefore": "28.0.0",
      "rationale": "lr-run-cancel is the one name for asking to cancel a run, shared with lr-subagent-panel; the alias fires right after it for one major."
    },
    {
      "tag": "lr-background-runs",
      "kind": "event",
      "name": "lr-run-open",
      "since": "unreleased",
      "replacement": {
        "kind": "event",
        "name": "lr-run-activate",
        "usage": "@lr-run-activate"
      },
      "removalNotBefore": "28.0.0",
      "rationale": "lr-run-activate matches the activate vocabulary of the library's other run lists; the alias fires right after it for one major."
    },
    {
      "tag": "lr-change-review",
      "kind": "event",
      "name": "lr-change-decision",
      "since": "unreleased",
      "replacement": {
        "kind": "event",
        "name": "lr-change-decision-request",
        "usage": "@lr-change-decision-request"
      },
      "removalNotBefore": "28.0.0",
      "rationale": "lr-change-decision-request names what the event is, a request the host decides on; the alias fires right after it for one major."
    },
    {
      "tag": "lr-subagent-panel",
      "kind": "event",
      "name": "lr-cancel",
      "since": "unreleased",
      "replacement": {
        "kind": "event",
        "name": "lr-run-cancel",
        "usage": "@lr-run-cancel"
      },
      "removalNotBefore": "28.0.0",
      "rationale": "lr-run-cancel is the one name for asking to cancel a run, shared with lr-agent-run; the alias fires right after it for one major."
    },
    {
      "tag": "lr-tool-call-chip",
      "kind": "slot",
      "name": "icon",
      "since": "unreleased",
      "replacement": {
        "kind": "slot",
        "name": "status-icon",
        "usage": "slot=\"status-icon\""
      },
      "removalNotBefore": "28.0.0",
      "rationale": "The status glyph uses the purpose-specific slot name; existing icon slot content remains rendered during migration."
    }
  ]
}
