{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.lyra-ui.com/schemas/translation-reviews.schema.json",
  "title": "Lyra UI translation release reviews",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "source",
    "upstreamLocaleBreadth",
    "releasePlan",
    "catalogs"
  ],
  "properties": {
    "$schema": {
      "const": "./translation-reviews.schema.json"
    },
    "schemaVersion": {
      "const": 2
    },
    "source": {
      "$ref": "#/$defs/sourceSnapshot"
    },
    "upstreamLocaleBreadth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "webAwesome",
        "shoelace",
        "normalizedUnion"
      ],
      "properties": {
        "webAwesome": {
          "$ref": "#/$defs/upstreamPin"
        },
        "shoelace": {
          "$ref": "#/$defs/upstreamPin"
        },
        "normalizedUnion": {
          "$ref": "#/$defs/localeList"
        }
      }
    },
    "releasePlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "builtIn",
        "shippedBeforeV8",
        "v8ReleaseExpansion",
        "deferred",
        "regionalExtensions",
        "selectionRationale"
      ],
      "properties": {
        "builtIn": {
          "$ref": "#/$defs/localeList"
        },
        "shippedBeforeV8": {
          "$ref": "#/$defs/localeList"
        },
        "v8ReleaseExpansion": {
          "$ref": "#/$defs/localeList"
        },
        "deferred": {
          "$ref": "#/$defs/localeList"
        },
        "regionalExtensions": {
          "$ref": "#/$defs/localeList"
        },
        "additionalCatalogs": {
          "$ref": "#/$defs/localeList"
        },
        "selectionRationale": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 12
          }
        }
      }
    },
    "catalogs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/catalogReview"
      }
    }
  },
  "$defs": {
    "localeList": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 2
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "keyCount",
        "sha256"
      ],
      "properties": {
        "keyCount": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "sourceSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "keyCount",
        "sha256"
      ],
      "properties": {
        "path": {
          "const": "src/internal/localization.ts#DEFAULT_STRINGS"
        },
        "keyCount": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "upstreamPin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "commit",
        "locales"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "locales": {
          "$ref": "#/$defs/localeList"
        }
      }
    },
    "catalogReview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "locale",
        "direction",
        "reviewTier",
        "source",
        "catalog",
        "translator",
        "reviewer",
        "englishIdenticalAllowlist"
      ],
      "properties": {
        "locale": {
          "type": "string",
          "minLength": 2
        },
        "direction": {
          "enum": [
            "ltr",
            "rtl"
          ]
        },
        "reviewTier": {
          "enum": [
            "ai-assisted",
            "independent-human",
            "native-speaker"
          ],
          "description": "Evidence tier; status remains a separate release workflow state."
        },
        "source": {
          "$ref": "#/$defs/snapshot"
        },
        "catalog": {
          "$ref": "#/$defs/snapshot"
        },
        "translator": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "role",
            "completedAt",
            "evidence"
          ],
          "properties": {
            "status": {
              "const": "complete-original"
            },
            "role": {
              "const": "project localization contributor"
            },
            "completedAt": {
              "type": "string",
              "format": "date"
            },
            "evidence": {
              "type": "string",
              "minLength": 24
            }
          }
        },
        "reviewer": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "role",
            "reviewedAt",
            "evidence"
          ],
          "properties": {
            "status": {
              "enum": [
                "pending-independent-review",
                "approved"
              ]
            },
            "role": {
              "const": "independent localization reviewer"
            },
            "identity": {
              "type": "string",
              "minLength": 2,
              "description": "Attributable public name or stable handle; required for human review tiers."
            },
            "catalogSha256": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$",
              "description": "Exact catalog snapshot reviewed; required for human review tiers."
            },
            "reviewedAt": {
              "type": [
                "string",
                "null"
              ],
              "format": "date"
            },
            "evidence": {
              "type": [
                "string",
                "null"
              ]
            },
            "evidenceUrl": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://",
              "description": "Public review record identifying the reviewed locale and current catalog snapshot; submitting an intake issue alone is not approval."
            }
          }
        },
        "englishIdenticalAllowlist": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "messagePath",
              "rationale"
            ],
            "properties": {
              "messagePath": {
                "type": "string",
                "minLength": 1
              },
              "rationale": {
                "type": "string",
                "minLength": 16
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "reviewTier": {
                "enum": [
                  "independent-human",
                  "native-speaker"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "reviewer": {
                "required": [
                  "identity",
                  "catalogSha256",
                  "evidenceUrl"
                ],
                "properties": {
                  "status": {
                    "const": "approved"
                  },
                  "reviewedAt": {
                    "type": "string",
                    "format": "date"
                  },
                  "evidence": {
                    "type": "string",
                    "minLength": 24
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "reviewTier": {
                "const": "native-speaker"
              }
            }
          },
          "then": {
            "properties": {
              "reviewer": {
                "properties": {
                  "status": {
                    "const": "approved"
                  },
                  "reviewedAt": {
                    "type": "string",
                    "format": "date"
                  },
                  "evidence": {
                    "type": "string",
                    "minLength": 24
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
