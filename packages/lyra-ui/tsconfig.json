{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "forceConsistentCasingInFileNames": true,
    "moduleDetection": "force",
    "noUncheckedSideEffectImports": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUncheckedIndexedAccess": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "useDefineForClassFields": false,
    "experimentalDecorators": true,
    "declaration": true,
    // Local-only: the published build runs through tsconfig.build.json, which turns
    // both of these off because `dist` ships without `src`, leaving every emitted map
    // dangling (and a dangling declarationMap breaks Go-to-Definition rather than
    // falling back to the .d.ts). Keep them here so editors, `tsc --noEmit -p
    // tsconfig.json` and the type tests that extend this file keep full mapping.
    "sourceMap": true,
    "declarationMap": true,
    "noEmitOnError": true,
    // Strips `@internal`-tagged exports (e.g. flag.ts's test-only
    // __setFlagUrlResolverForTesting seam) from the emitted .d.ts, so a
    // consumer never sees them via autocomplete/type-checking even though
    // the plain JS output still exports them at runtime.
    "stripInternal": true,
    "outDir": "dist",
    "rootDir": "src",
    "skipLibCheck": true,
    "verbatimModuleSyntax": true
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts", "src/**/*.stories.ts"]
}
