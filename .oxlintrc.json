{
  // Low-noise, correctness-focused oxlint configuration. Run through `pnpm run lint:oxlint`
  // (type-aware for every package's src, syntax-only for the .mjs tooling); see
  // docs/agents/ci-and-gates.md. Rules switched off below fire on idioms this code base uses on
  // purpose; do not re-enable one without auditing its findings first.
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  // Lit template and web-component rules run as JS plugins on oxlint's own parser (no TypeScript, no
  // ESLint). The plugins only recognise a class as a Lit element when it is LitElement, a
  // @customElement, or listed in settings.*.elementBaseClasses; check:lit-bases keeps that list
  // equal to the repo's real base classes and test:lit-lint proves every enabled rule still fires.
  "jsPlugins": ["eslint-plugin-lit", "eslint-plugin-wc"],
  "settings": {
    "lit": { "elementBaseClasses": ["CatalogPickerElement", "ColorPickerBase", "EmojiPickerBase", "LyraAvPlayerBase", "LyraBadge", "LyraCalendarViewerBase", "LyraCatalogPickerBase", "LyraCatalogPickerElement", "LyraChart", "LyraChatComposerBase", "LyraCheckboxBase", "LyraCodeBlockBase", "LyraCodeEditorBase", "LyraContactViewerBase", "LyraCsvViewerBase", "LyraDatasetViewerBase", "LyraDateInputBase", "LyraDialog", "LyraDiffViewBase", "LyraDocxViewerBase", "LyraEbookViewerBase", "LyraElement", "LyraEmailViewerBase", "LyraFormControlElement", "LyraGeoJsonViewer", "LyraGeoJsonViewerBase", "LyraHtmlViewerBase", "LyraImageViewerBase", "LyraIncludeBase", "LyraInput", "LyraInputBase", "LyraInputShared", "LyraKnownDateBase", "LyraMarkdownRuntimeElement", "LyraMenuItem", "LyraNotebookViewerBase", "LyraOtpInputBase", "LyraPdfViewerBase", "LyraPhoneInputBase", "LyraPopover", "LyraPptxViewerBase", "LyraProgressBase", "LyraRadio", "LyraRadioBase", "LyraSliderBase", "LyraSourceCardBase", "LyraSpreadsheetViewerBase", "LyraSvgViewerBase", "LyraSwitchBase", "LyraTextareaBase", "LyraTimeInputBase", "LyraXmlViewerBase", "MarkdownRuntimeBase", "StreamingTextRuntimeBase"] },
    "wc": { "elementBaseClasses": ["CatalogPickerElement", "ColorPickerBase", "EmojiPickerBase", "LyraAvPlayerBase", "LyraBadge", "LyraCalendarViewerBase", "LyraCatalogPickerBase", "LyraCatalogPickerElement", "LyraChart", "LyraChatComposerBase", "LyraCheckboxBase", "LyraCodeBlockBase", "LyraCodeEditorBase", "LyraContactViewerBase", "LyraCsvViewerBase", "LyraDatasetViewerBase", "LyraDateInputBase", "LyraDialog", "LyraDiffViewBase", "LyraDocxViewerBase", "LyraEbookViewerBase", "LyraElement", "LyraEmailViewerBase", "LyraFormControlElement", "LyraGeoJsonViewer", "LyraGeoJsonViewerBase", "LyraHtmlViewerBase", "LyraImageViewerBase", "LyraIncludeBase", "LyraInput", "LyraInputBase", "LyraInputShared", "LyraKnownDateBase", "LyraMarkdownRuntimeElement", "LyraMenuItem", "LyraNotebookViewerBase", "LyraOtpInputBase", "LyraPdfViewerBase", "LyraPhoneInputBase", "LyraPopover", "LyraPptxViewerBase", "LyraProgressBase", "LyraRadio", "LyraRadioBase", "LyraSliderBase", "LyraSourceCardBase", "LyraSpreadsheetViewerBase", "LyraSvgViewerBase", "LyraSwitchBase", "LyraTextareaBase", "LyraTimeInputBase", "LyraXmlViewerBase", "MarkdownRuntimeBase", "StreamingTextRuntimeBase"] }
  },
  "categories": { "correctness": "error" },
  "env": { "browser": true, "es2022": true },
  "ignorePatterns": [
    "**/dist/**",
    "**/coverage/**",
    "**/storybook-static/**",
    "**/node_modules/**",
    "**/*.generated.ts",
    "**/src/translations/**",
    "**/fixtures/**",
    "**/visual-baselines/**",

    // Covered separately: these component directories are being reworked and their findings are
    // fixed with that work. Remove these entries once they are clean.
    "packages/lyra-ui/src/components/media/map/**",
    "packages/lyra-ui/src/components/media/image-viewer/**",
    "packages/lyra-ui/src/components/media/video/**",
    "packages/lyra-ui/src/components/retrieval/graph/**",
    "packages/lyra-ui/src/components/retrieval/knowledge-graph-explorer/**",
    "packages/lyra-ui/src/components/retrieval/embedding-explorer/**"
  ],
  "rules": {
    // Not in `correctness`, but the code base already writes `void promise` for every deliberate
    // fire-and-forget call; these enforce that convention.
    "typescript/no-misused-promises": "error",
    "typescript/switch-exhaustiveness-check": ["error", { "considerDefaultExhaustiveForUnions": true }],
    "eslint/no-unused-expressions": ["error", { "allowTernary": true, "allowShortCircuit": true }],

    // `correctness` rules that fire on intentional idioms here:
    "typescript/unbound-method": "off", // Lit `@event=${this.handler}` bindings; captured prototype getters
    "typescript/no-duplicate-type-constituents": "off", // generated union types in src/events.ts
    "typescript/no-base-to-string": "off", // `String(unknown)` in defensive snapshotting
    "typescript/no-this-alias": "off", // `const host = this` inside object-literal adapters
    "typescript/no-misused-spread": "off", // `[...code]` over ASCII-only ISO codes
    "eslint/no-self-assign": "off", // `tree.data = tree.data` re-runs the setter on purpose
    "eslint/no-control-regex": "off", // sanitizers match C0 control characters on purpose
    // `const { omitted, ...rest } = value` is the omit idiom; the patterns restate oxlint's defaults,
    // which passing any option object would otherwise reset.
    "eslint/no-unused-vars": ["error", {
      "ignoreRestSiblings": true,
      "argsIgnorePattern": "^_",
      "varsIgnorePattern": "^_",
      "caughtErrorsIgnorePattern": "^_",
      "destructuredArrayIgnorePattern": "^_"
    }],
    "unicorn/no-new-array": "off",
    "unicorn/no-useless-spread": "off", // snapshot-before-iterate copies
    "unicorn/no-useless-fallback-in-spread": "off"
  },
  "overrides": [
    {"files": ["packages/*/src/**/*.ts"], "excludeFiles": ["**/*.test.ts", "**/*.stories.ts", "**/*.d.ts"], "rules": {"lit/attribute-names": "error", "lit/attribute-value-entities": "error", "lit/binding-positions": "error", "lit/lifecycle-super": "error", "lit/no-duplicate-template-bindings": "error", "lit/no-invalid-escape-sequences": "error", "lit/no-invalid-html": "error", "lit/no-legacy-imports": "error", "lit/no-legacy-template-syntax": "error", "lit/no-property-change-update": "error", "lit/no-template-bind": "error", "lit/no-useless-template-literals": "error", "lit/no-value-attribute": "error", "lit/prefer-static-styles": "error", "lit/quoted-expressions": "error", "lit/value-after-constraints": "error", "wc/attach-shadow-constructor": "error", "wc/no-closed-shadow-root": "error", "wc/no-constructor-attributes": "error", "wc/no-constructor-params": "error", "wc/no-self-class": "error", "wc/no-typos": "error"}},
    {"files": ["packages/lyra-ui/src/components/forms/catalog-picker-base.ts", "packages/lyra-docs/src/docx/docx-editor.class.ts"], "rules": {"lit/binding-positions": "off", "lit/no-invalid-html": "off"}},
    {"files": ["packages/lyra-ui/src/components/utility/known-date/known-date.class.ts", "packages/lyra-ui/src/components/forms/otp-input/otp-input.class.ts", "packages/lyra-ui/src/components/forms/input/time-input.class.ts"], "rules": {"lit/value-after-constraints": "off"}},
    {"files": ["packages/lyra-ui/src/components/media/video/video.class.ts"], "rules": {"lit/attribute-names": "off"}},
    {"files": ["packages/lyra-ui/src/components/data/table/table.class.ts"], "rules": {"lit/no-value-attribute": "off"}},
    {"files": ["packages/lyra-ui/src/components/conversation/code-block/code-block-shared.ts"], "rules": {"lit/no-useless-template-literals": "off"}},
    {
      // The benchmark harness is content-hashed into every recorded result (benchmarks/compare.mjs
      // refuses to compare runs from different harness hashes), so editing it forces the previous
      // release to be re-measured. Its cleanup path rethrows `cleanup-failed` from a finally block;
      // fix that together with the next deliberate harness revision, then drop this override.
      "files": ["benchmarks/run.mjs"],
      "rules": { "eslint/no-unsafe-finally": "off" }
    },
    {
      "files": ["**/*.test.ts", "**/*.test.mjs", "**/*.stories.ts", "**/test/**", "**/src/testing/**"],
      "rules": {
        "eslint/no-unsafe-finally": "off", // cleanup in a finally block may rethrow an unexpected kill/close error
        "eslint/no-unused-expressions": "off", // chai: `expect(x).to.be.true`
        "eslint/no-sparse-arrays": "off",
        "eslint/no-unsafe-optional-chaining": "off",
        "eslint/no-useless-escape": "off",
        "typescript/no-floating-promises": "off", // un-awaited `el.show()` is common in specs
        "typescript/no-misused-promises": "off",
        "typescript/no-array-delete": "off",
        "typescript/no-implied-eval": "off", // specs run the theme bootstrap through `new Function`
        "typescript/require-array-sort-compare": "off",
        "typescript/no-redundant-type-constituents": "off",
        "typescript/no-unsafe-declaration-merging": "off",
        "typescript/restrict-template-expressions": "off",
        "typescript/no-useless-default-assignment": "off",
        "typescript/await-thenable": "off",
        "unicorn/no-thenable": "off" // intentional thenable fixtures
      }
    }
  ]
}
